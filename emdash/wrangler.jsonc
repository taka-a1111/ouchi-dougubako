{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ouchi-dougubako-site",
	"main": "./src/worker.ts",
	// ouchidougubako.com と www（カスタムドメイン、ダッシュボードで追加済み）で公開。workers.dev は閉じる
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ouchi-dougubako-site",
			"database_id": "463efb9e-134a-4f1a-b691-d9dd909e9e5b",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ouchi-dougubako-media",
		},
	],
	// EmDash の予約公開などの処理
	"triggers": {
		"crons": ["* * * * *"],
	},
}
